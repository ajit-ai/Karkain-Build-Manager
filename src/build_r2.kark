// Karkain Build Manager - Round 2 workflow: execute the REAL Karkain compiler
// via system() on a local .kark source, capture its stdout to a file, parse the
// exit code, load the build configuration from configs/build.dat and retain a
// build history with timestamp-free sequence numbers. Additive to Round 1.

func r2_load_state(path) {
    let parts = split(readFile(path), "\n")
    let out = []
    let i = 0
    while (i < len(parts)) {
        if (parts[i] != "") { push(out, parts[i]) }
        i = i + 1
    }
    return out
}

func r2_field(rec, idx) {
    let f = split(rec, "|")
    if (len(f) > idx) { return f[idx] }
    return ""
}

func r2_find2(state, t, k2) {
    let i = 0
    while (i < len(state)) {
        let f = split(state[i], "|")
        if (len(f) > 1) {
            if (f[0] == t && f[1] == k2) { return state[i] }
        }
        i = i + 1
    }
    return ""
}

func r2_upsert2(state, t, k2, rec) {
    let out = []
    let replaced = 0
    let i = 0
    while (i < len(state)) {
        let f = split(state[i], "|")
        let ismatch = 0
        if (len(f) > 1) { if (f[0] == t && f[1] == k2) { ismatch = 1 } }
        if (ismatch == 1) { push(out, rec); replaced = 1 } else { push(out, state[i]) }
        i = i + 1
    }
    if (replaced == 0) { push(out, rec) }
    return out
}

func r2_ensure_outdir() {
    return system("powershell -c New-Item -ItemType Directory -Force -Path C:/Windows/Temp/karkain-op > NUL")
}

func r2_persist(path, lines) {
    let out = ""
    let i = 0
    while (i < len(lines)) {
        out = out + lines[i] + "\n"
        i = i + 1
    }
    writeFile(path, out)
}

func r2_run() {
    let cfg = split(trim(readFile("configs/build.dat")), "|")
    let compiler = cfg[0]
    let source = cfg[1]
    let target = cfg[2]
    r2_ensure_outdir()
    print("BM_R2 config compiler=" + compiler + " source=" + source + " target=" + target)

    let cmds = split(readFile("data/r2_commands.dat"), "\n")
    let state = r2_load_state("data/r2_state.dat")
    let history = r2_load_state("data/r2_history.dat")
    let report = []
    let success = 0
    let failed = 0
    let i = 0
    while (i < len(cmds)) {
        let line = trim(cmds[i])
        if (line != "") {
            let f = split(line, "|")
            let op = f[0]
            if (op == "BUILD") {
                let name = f[1]
                let cfile = "C:/Windows/Temp/karkain-op/bm_check.txt"
                let bfile = "C:/Windows/Temp/karkain-op/bm_build.txt"
                let ccode = system(compiler + " check " + source + " > " + cfile)
                let bcode = system(compiler + " build " + source + " -o C:/Windows/Temp/karkain-op/bm_r2.exe --target " + target + " > " + bfile)
                let code = bcode
                if (ccode != 0) { code = ccode }
                let result = "SUCCESS"
                if (code != 0) { result = "FAIL" }

                let seq = len(history) + 1
                push(history, "HIST|" + str(seq) + "|" + name + "|" + str(code) + "|" + result + "|" + bfile)
                state = r2_upsert2(state, "RESULT", name, "RESULT|" + name + "|" + str(code) + "|" + result + "|" + str(seq))

                let outtxt = "(empty)"
                if (bcode == 0) { outtxt = trim(readFile(bfile)) }
                if (result == "SUCCESS") { success = success + 1 } else { failed = failed + 1 }
                print("BM_R2 build " + name + " seq=" + str(seq) + " check=" + str(ccode) + " build=" + str(bcode) + " code=" + str(code) + " result=" + result)
                print("BM_R2 stdout " + outtxt)
                print("BM_R2 capture " + bfile)
                push(report, "BUILD " + name + " seq=" + str(seq) + " " + result)
            }
            if (op == "STATUS") {
                let rec = r2_find2(state, "RESULT", f[1])
                let result = "NONE"
                let seq = "0"
                if (rec != "") { result = r2_field(rec, 3); seq = r2_field(rec, 4) }
                print("BM_R2 status " + f[1] + " seq=" + seq + " result=" + result)
                push(report, "STATUS " + f[1] + " " + result)
            }
        }
        i = i + 1
    }
    r2_persist("data/r2_state.dat", state)
    r2_persist("data/r2_history.dat", history)
    r2_persist("data/r2_report.dat", report)
    print("BM_R2_OK builds=" + str(len(history)) + " success=" + str(success) + " failed=" + str(failed) + " history=" + str(len(history)))
}
