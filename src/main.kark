// Karkain Build Manager - first functional slice.
// Commands in data/commands.dat (pipe-delimited):
//   TARGET|name|description   define a build target
//   BUILD|name|result         record/replace the latest build result
//   RESULT|name               display the retained build result
//   LIST                      list targets with their retained result
// The latest build result per target is retained in data/state.dat;
// an action log is written to data/report.dat.

func load_state(path) {
    let parts = split(readFile(path), "\n")
    let out = []
    let i = 0
    while (i < len(parts)) {
        if (parts[i] != "") { push(out, parts[i]) }
        i = i + 1
    }
    return out
}

func upsert2(state, t, k2, rec) {
    let out = []
    let replaced = 0
    let i = 0
    while (i < len(state)) {
        let f = split(state[i], "|")
        let is_match = 0
        if (len(f) > 1) {
            if (f[0] == t && f[1] == k2) { is_match = 1 }
        }
        if (is_match == 1) { push(out, rec); replaced = 1 } else { push(out, state[i]) }
        i = i + 1
    }
    if (replaced == 0) { push(out, rec) }
    return out
}

func find_rec(state, t, k2) {
    let i = 0
    while (i < len(state)) {
        let f = split(state[i], "|")
        if (len(f) > 1) {
            if (f[0] == t && f[1] == k2) { return state[i] }
        }
        i = i + 1
    }
    return ""
}

func count_type(state, t) {
    let n = 0
    let i = 0
    while (i < len(state)) {
        let f = split(state[i], "|")
        if (f[0] == t) { n = n + 1 }
        i = i + 1
    }
    return n
}

func list_all(state) {
    let i = 0
    while (i < len(state)) {
        let f = split(state[i], "|")
        if (f[0] == "TARGET") {
            if (len(f) > 2) {
                let r = find_rec(state, "RESULT", f[1])
                let result = "NONE"
                if (r != "") {
                    let g = split(r, "|")
                    if (len(g) > 2) { result = g[2] }
                }
                print("TARGET " + f[1] + " - " + f[2] + " result=" + result)
            }
        }
        i = i + 1
    }
}

func persist(path, lines) {
    let out = ""
    let i = 0
    while (i < len(lines)) {
        out = out + lines[i] + "\n"
        i = i + 1
    }
    writeFile(path, out)
}

func main() {
    let cmds = split(readFile("data/commands.dat"), "\n")
    let state = load_state("data/state.dat")
    let report = []
    let builds = 0
    let i = 0
    while (i < len(cmds)) {
        let line = trim(cmds[i])
        if (line != "") {
            let f = split(line, "|")
            let op = f[0]
            if (op == "TARGET") {
                state = upsert2(state, "TARGET", f[1], "TARGET|" + f[1] + "|" + f[2])
                let msg = "TARGET " + f[1] + " " + f[2]
                print(msg)
                push(report, msg)
            }
            if (op == "BUILD") {
                state = upsert2(state, "RESULT", f[1], "RESULT|" + f[1] + "|" + f[2])
                builds = builds + 1
                let msg = "BUILD " + f[1] + " " + f[2]
                print(msg)
                push(report, msg)
            }
            if (op == "RESULT") {
                let r = find_rec(state, "RESULT", f[1])
                let result = "NONE"
                if (r != "") {
                    let g = split(r, "|")
                    if (len(g) > 2) { result = g[2] }
                }
                print("RESULT " + f[1] + " " + result)
                push(report, "RESULT " + f[1] + " " + result)
            }
            if (op == "LIST") {
                list_all(state)
                push(report, "LIST")
            }
        }
        i = i + 1
    }
    persist("data/state.dat", state)
    persist("data/report.dat", report)
    print("BUILD_MANAGER_OK targets=" + str(count_type(state, "TARGET")) + " builds=" + str(builds) + " results=" + str(count_type(state, "RESULT")))
    r2_run()
}
