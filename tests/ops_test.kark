// Karkain Build Manager - Round 2 self-contained tests.

func r2t_result_for(code) {
    let result = "SUCCESS"
    if (code != 0) { result = "FAIL" }
    return result
}

func test_r2_exit_code_parse() {
    assert_eq(r2t_result_for(0), "SUCCESS")
    assert_eq(r2t_result_for(3), "FAIL")
    assert_eq(r2t_result_for(1), "FAIL")
}

func test_r2_sequence_numbers() {
    let history = []
    let i = 0
    while (i < 3) {
        let seq = len(history) + 1
        push(history, "HIST|" + str(seq) + "|local-main|SUCCESS")
        i = i + 1
    }
    assert_eq(len(history), 3)
    assert_eq(split(history[0], "|")[1], "1")
    assert_eq(split(history[1], "|")[1], "2")
    assert_eq(split(history[2], "|")[1], "3")
}

func test_r2_config_parse() {
    let cfg = split("C:/karkain.exe|src/main.kark|x86_64-windows", "|")
    assert_eq(len(cfg), 3)
    assert_eq(cfg[0], "C:/karkain.exe")
    assert_eq(cfg[1], "src/main.kark")
    assert_eq(cfg[2], "x86_64-windows")
}
